# ---------- Accounts (required) ----------
# MongoDB Atlas free M0 cluster: https://www.mongodb.com/cloud/atlas/register
# Cluster -> Connect -> Drivers -> copy the mongodb+srv:// connection string.
MONGODB_URI=mongodb+srv://sahnawashussain98_db_user:67qkJG1mSrf32jCD@cluster0.5dix9rk.mongodb.net
MONGODB_DB=pathforge

# Google OAuth: https://console.cloud.google.com/apis/credentials
# Create an OAuth client (Web application) and add this authorized redirect URI:
#   http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the httpOnly session cookie. Generate one with: openssl rand -hex 32
AUTH_SECRET=

# Optional — only needed behind a proxy or a custom domain.
# GOOGLE_REDIRECT_URI=https://your-domain.com/api/auth/google/callback
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# ---------- Provider ----------
# "zai" (default) — Z.ai's GLM Flash models, free with no daily cap, but slow (~1-2 min/plan).
# "groq" / "cerebras" — fast free tiers (seconds per plan, daily token caps).
# "openai" — any OpenAI-compatible endpoint.
# "ollama" — a local model with no request limits at all.
# "gemini" — Google Gemini.
# If AI_PROVIDER is unset: Groq, then Cerebras, then Z.ai (when a key exists), then Gemini,
# then an OpenAI-compatible endpoint when AI_BASE_URL is set.
# AI_PROVIDER=zai

# ---------- Z.ai (default, free) ----------
# GLM-4.5-Flash / GLM-4.7-Flash are priced at $0. Free key, no card:
# https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=

# Optional — override the model. The app falls back through
# glm-4.5-flash → glm-4.7-flash, so it keeps working if one is retired.
# AI_MODEL=glm-4.5-flash

# ---------- Fast free tiers (recommended for speed) ----------
# Groq: https://console.groq.com/keys (free, no card). A full plan takes seconds instead of minutes.
# GROQ_API_KEY=
# AI_PROVIDER=groq
# AI_MODEL=openai/gpt-oss-120b

# Cerebras: https://cloud.cerebras.ai (free tier, ~1M tokens/day).
# CEREBRAS_API_KEY=
# AI_PROVIDER=cerebras
# AI_MODEL=gpt-oss-120b

# ---------- Google Gemini (optional) ----------
# Get a free Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — pin a specific model. The app falls back through
# gemini-3.8-flash → gemini-3.7-flash → gemini-3.6-flash → gemini-3.5-flash
# GEMINI_MODEL=gemini-3.8-flash

# Optional — route requests through a proxy or gateway (e.g. a self-hosted endpoint).
# GEMINI_BASE_URL=https://your-gateway.example.com

# ---------- Other OpenAI-compatible endpoints ----------
# Works with Ollama or LM Studio on localhost, and hosted services such as
# OpenRouter. For anything other than Ollama, also set AI_PROVIDER=openai.
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=
# AI_MODEL=
#
# Local, no request limit:
# AI_PROVIDER=ollama
# AI_MODEL=qwen2.5:7b        # any model from `ollama list`
#
# Set to false if the endpoint rejects response_format: { type: "json_object" }
# AI_JSON_MODE=true
